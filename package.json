{
  "name": "cc-skill",
  "productName": "CC Skill",
  "version": "0.0.2",
  "description": "统一管理 Claude Code / Codex / OpenClaw / ZCode / Qoder 等 AI Agent 的 SKILL —— 链接共享、去重合并、项目级管理、WebDAV 备份 | Manage AI agent SKILLs across CLIs from one desktop app",
  "author": "kaamil",
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com.ccskill.app.git"
  },
  "homepage": "https://github.com.ccskill.app#readme",
  "bugs": "https://github.com.ccskill.app/issues",
  "keywords": [
    "electron",
    "ai-agent",
    "skills",
    "claude-code",
    "codex",
    "openclaw",
    "zcode",
    "qoder",
    "webdav",
    "windows"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.ccskill.app",
    "productName": "CC Skill",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipc-channels.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "marked": "^18.0.13"
  }
}
